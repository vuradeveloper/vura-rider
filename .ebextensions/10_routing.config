# Road routing for the driver app (turn-by-turn) and the rider route preview.
#
# WHY THIS FILE EXISTS: ROUTE_PROVIDER_URL was never set on the Elastic
# Beanstalk environment, so in production every `GET /api/route` answered
#   503 {"error":"Routing provider not configured (set ROUTE_PROVIDER_URL)"}
# and the driver map had NO route line, NO ETA and NO turn instructions.
#
# It is committed here (like RUN_MIGRATIONS_ON_BOOT) because `eb setenv`
# triggers its own full deployment, which has broken this environment before
# (2026-10-15 and 2026-10-19). `.ebextensions` is applied by the normal deploy.
#
# The value is the public OSRM endpoint. It is fine for the current volume and
# needs no key, but it has no SLA: before traffic grows, change ONLY this value
# to a self-hosted OSRM (deploy/SELFHOST-MAPS.md) or a paid OSRM-compatible
# provider. No code change is needed.
option_settings:
  aws:elasticbeanstalk:application:environment:
    ROUTE_PROVIDER_URL: "https://router.project-osrm.org"
