# One flag, in the repo, so NO `eb setenv` is ever needed for migrations
# (setenv triggers its own full deployment, which failed on 2026-10-15 and
# left the environment not-Ready). Applied on every deploy; the migrations
# themselves are additive + idempotent (recorded in schema_migrations), so
# having this on continuously is safe.
option_settings:
  aws:elasticbeanstalk:application:environment:
    RUN_MIGRATIONS_ON_BOOT: "true"
