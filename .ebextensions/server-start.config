option_settings:
  # Health-check the API (nginx -> node). Startup is governed by the root
  # Procfile (build + web targets), not any NodeCommand.
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /health
  # The pre-deploy hook (server-deploy.config) runs `npm install` for the
  # server's ~100MB of deps. On a fresh/bootstrapped instance this can exceed
  # EB's default 10-minute command timeout — which aborts and reverts the
  # deploy (seen Sep 19: "instances have not responded in the allowed
  # command timeout"). Give the deploy command up to 30 minutes headroom.
  aws:elasticbeanstalk:command:
    Timeout: 1800