option_settings:
  # Force Elastic Beanstalk to run OUR server, not whatever the root
  # package.json (the Expo app) happens to define. On the Amazon Linux 2023
  # Node.js platform, this process-level command is the supported replacement
  # for the old `aws:elasticbeanstalk:container:nodejs:NodeCommand` option.
  aws:elasticbeanstalk:environment:process:default:
    Command: "cd /var/app/current/server && node dist/index.js"
    HealthCheckPath: /health