files:
  "/opt/elasticbeanstalk/hooks/appdeploy/pre/50_npm_install_server.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      set -e
      # The repo is a monorepo: the backend lives in /server. EB's Node platform
      # would normally run `npm install` at the app root (the Expo app), which
      # is heavy and unnecessary. Install ONLY the server deps here; the
      # compiled server (server/dist) is already committed, and the Procfile at
      # the repo root starts it via `node dist/index.js`.
      #
      # IMPORTANT: at `appdeploy/pre` time the NEW release is staged under
      # /var/app/staging and is only moved to /var/app/current AFTER these
      # hooks finish. Installing into `current` here would put deps in the
      # stale/old folder, so the fresh app would boot with NO node_modules
      # ("Cannot find module 'dotenv/config'"). Resolve the real staged path:
      BASE=/var/app
      if [ -d "$BASE/staging/server" ]; then
        APP_DIR="$BASE/staging/server"
      else
        APP_DIR="$BASE/current/server"
      fi
      cd "$APP_DIR"
      npm install --omit=dev --ignore-scripts --no-audit --no-fund
      echo "VURA: server deps installed into $APP_DIR"