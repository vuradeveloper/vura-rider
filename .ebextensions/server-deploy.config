files:
  "/opt/elasticbeanstalk/hooks/appdeploy/pre/50_npm_install_server.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      set -e
      # The repo is a monorepo: the backend lives in /server. EB's Node platform
      # would normally run `npm install` at the app root (the Expo app), which
      # is heavy and unnecessary. We ship server/node_modules INSIDE the deploy
      # zip (pure-JS, no native binaries), so a fresh instance boots instantly
      # without a 100MB `npm install` that routinely blew EB's command timeout.
      # The `npm install` below is therefore only a fallback — it is skipped
      # when node_modules is already present.
      #
      # Platform differences: on some EB versions the NEW release is at
      # /var/app/staging at pre-deploy time (moved to /var/app/current AFTER
      # hooks); on others it is already at /var/app/current. Never install into
      # the wrong one or the live app boots with NO node_modules
      # ("Cannot find module 'dotenv/config'"). Resolve the real app dir by
      # finding which one actually holds the newest server/dist/index.js.
      BASE=/var/app
      choose() {
        local st cur
        st="$BASE/staging/server/dist/index.js"
        cur="$BASE/current/server/dist/index.js"
        if [ -f "$st" ] && [ -f "$cur" ]; then
          if [ "$st" -nt "$cur" ]; then echo "$BASE/staging/server"; else echo "$BASE/current/server"; fi
        elif [ -f "$st" ]; then echo "$BASE/staging/server"
        elif [ -f "$cur" ]; then echo "$BASE/current/server"
        else
          echo "VURA: server/dist/index.js not found in staging or current" >&2
          exit 1
        fi
      }
      APP_DIR="$(choose)"
      echo "VURA: server dir is $APP_DIR"
      if [ -d "$APP_DIR/node_modules" ] && [ -e "$APP_DIR/node_modules/express/package.json" ]; then
        echo "VURA: server node_modules already shipped in the package — skipping npm install"
      else
        echo "VURA: installing server deps into $APP_DIR"
        cd "$APP_DIR"
        npm install --omit=dev --ignore-scripts --no-audit --no-fund
        node -e "require('dotenv/config'); console.log('VURA: dotenv/config OK')" || true
        echo "VURA: server deps ready in $APP_DIR"
      fi