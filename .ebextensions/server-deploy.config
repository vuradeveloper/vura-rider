files:
  "/opt/elasticbeanstalk/hooks/appdeploy/pre/50_npm_install_server.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      set -e
      # The repo is a monorepo: the backend lives in /server. EB's Node platform
      # would normally run `npm install` at the app root (the Expo app), which
      # fails on the instance. Instead install ONLY the server deps, then run
      # the compiled server directly (dist/ is committed).
      cd /var/app/current/server
      npm ci --omit=dev --ignore-scripts
      echo "VURA: server deps installed successfully"

  "/opt/elasticbeanstalk/hooks/appdeploy/pre/51_kill_root_procfile.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Ensure EB doesn't try to run the root Procfile (which points to Expo).
      # The server is started via the "server/Procfile" style command below.
      exit 0

option_settings:
  aws:elasticbeanstalk:container:nodejs:
    NodeCommand: "cd /var/app/current/server && node dist/index.js"