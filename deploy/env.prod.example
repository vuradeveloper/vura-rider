# ─────────────────────────────────────────────────────────────────────────────
# Vura — production environment TEMPLATE (safe to commit; placeholders only).
#
# Use it as:   cp deploy/env.prod.example deploy/production.env   (gitignored)
# then fill the real values locally and push them to Elastic Beanstalk with:
#     eb setenv $(grep -v '^#' deploy/production.env | grep '=' | tr '\n' ' ')
# Never commit the filled-in file. Full explanation: deploy/AWS-NEW-ACCOUNT-SETUP.md §4
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# PostgreSQL (RDS; private, SSL required)
DB_HOST=<your-rds-endpoint>.rds.amazonaws.com
DB_PORT=5432
DB_NAME=vura
DB_USER=vura_admin
DB_PASSWORD=<ROTATE-strong-password>
DB_SSL=true

# Firebase Admin — env-var path (no service-account file on the instance)
FIREBASE_PROJECT_ID=vura-f667d
FIREBASE_CLIENT_EMAIL=<firebase-adminsdk-...@vura-f667d.iam.gserviceaccount.com>
FIREBASE_PRIVATE_KEY_B64=<base64 of the JSON's private_key field>

# S3 document storage
AWS_S3_BUCKET=<vura-driver-docs-accountid>
AWS_S3_REGION=af-south-1

# CORS (include the Capacitor origins)
ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081,https://localhost,capacitor://localhost,http://localhost,https://ridevura.com,https://www.ridevura.com,https://api.ridevura.com

# Public base URL used in share links
PUBLIC_BASE_URL=https://api.ridevura.com

# Rate limiting (do not lower — 100 once caused 429 storms)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=6000
ROUTE_RATE_LIMIT_MAX=300
LOG_LEVEL=info

# Payments
PAYMENTS_MODE=live
PAYSTACK_SECRET_LIVE=<ROTATE-sk_live_...>
PAYSTACK_PUBLIC_LIVE=<pk_live_...>
PAYSTACK_CALLBACK_URL=https://api.ridevura.com/api/payments/return

# Email (Resend)
RESEND_API_KEY=<ROTATE-re_...>
RESEND_FROM_EMAIL=onboarding@ridevura.com

# Admin list + device-log keys
ADMIN_EMAILS=<you@ridevura.com>
DEV_LOG_WRITE_KEY=<random-string>
DEV_LOG_READ_KEY=<random-string>

# ── Optional (only if the feature is used) ──
# PAYSTACK_SECRET_TEST=<sk_test_...>          # PAYMENTS_MODE=sandbox
# HERE_API_KEY=<here-key>                     # Autosuggest/Geocoding
# ROUTE_PROVIDER_URL=http://<maps-ip>:8080    # self-hosted OSRM
# NOMINATIM_URL=http://<maps-ip>:8081         # self-hosted geocoding
# SEARCH_PROVIDER=nominatim
