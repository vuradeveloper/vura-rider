NODE_ENV=development
PORT=3000

# PostgreSQL
# NOTE: The current DB is AWS RDS `vura-prod` in af-south-1 (Cape Town) —
# see deploy/ACCOUNT.md. DB_HOST below must match deploy/production.env.
DB_HOST=<your-rds-host>
DB_PORT=5432
DB_NAME=<your-db-name>
DB_USER=<your-db-user>
DB_PASSWORD=<your-db-password>

# Firebase Admin (from Firebase Console > Project Settings > Service Accounts)
FIREBASE_PROJECT_ID=<your-firebase-project-id>
FIREBASE_CLIENT_EMAIL=<firebase-adminsdk-...@<project>.iam.gserviceaccount.com>
FIREBASE_PRIVATE_KEY=<paste-the-service-account-private-key-here>

# CORS — explicit origins only; never use "*" with credentials=true.
ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081

# Device-log sink. REQUIRED in production; if blank, the sink/viewer fail closed.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEV_LOG_WRITE_KEY=
DEV_LOG_READ_KEY=
DEV_LOG_RATE_MAX=120

# ── Safety / 2FA ──
# SOS and missed-RideCheck emails go here (comma-separated on-call list).
# Without it those alerts stay in the admin console only.
SAFETY_ALERT_EMAIL=
# Encrypts admin TOTP secrets AND rider/driver 2FA secrets. Set it once, keep
# it stable; changing it makes existing authenticator enrolments unreadable.
ADMIN_2FA_KEY=
# Signs marketing-email unsubscribe links. Set once and keep it stable; if it
# changes, old unsubscribe links stop working (users can still use a new email).
EMAIL_UNSUB_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug

# Pay Later / payments
# mock = simulated Paystack responses (default). sandbox = Paystack TEST key.
# live = Paystack LIVE key (real money).
PAYMENTS_MODE=mock
# Set to 1 to force mock collections to fail (tests the overdue/freeze path).
# PAYMENTS_MOCK_FAIL_COLLECT=1

# ── Paystack hosted payments ──
# Put the REAL values in server/.env (never in git). Placeholders shown here.
# Paystack gives you a secret key per business: TEST and LIVE.
#   PAYMENTS_MODE=sandbox → uses PAYSTACK_SECRET_TEST (test card 4084084084084081)
#   PAYMENTS_MODE=live    → uses PAYSTACK_SECRET_LIVE  (real money)
# Paystack SA checkout: https://paystack.com
PAYSTACK_SECRET_TEST=
PAYSTACK_SECRET_LIVE=
PAYSTACK_PUBLIC_LIVE=
# Redirect-back URL on this server, e.g.
#   https://ridevura.com/api/payments/return
PAYSTACK_CALLBACK_URL=

# ── Card preauthorization (hold → capture / release) ──
# Docs: https://paystack.com/docs/payments/card-preauthorization/
# PAYSTACK_SECRET_KEY is an OPTIONAL single-key fallback: when neither
# PAYSTACK_SECRET_TEST nor PAYSTACK_SECRET_LIVE is set, it is used instead.
PAYSTACK_SECRET_KEY=
# Days until an uncaptured hold auto-expires. Docs allow 1..7 (default 5);
# we ship 1 so an abandoned hold frees the rider's money the next day.
PREAUTH_EXPIRE_DAYS=1
# Minutes a ride may sit in searching/no_drivers before the reaper releases
# its hold (requirement: "no driver found → release immediately").
PREAUTH_STUCK_SEARCH_MINUTES=15
# Webhook URL to register in Paystack Dashboard > Settings > Webhooks:
#   https://api.ridevura.com/api/paystack/webhook
# (verified via x-paystack-signature = HMAC SHA512 of the raw body with the
#  secret key — never process events without it.)

# ── Ride Now, Pay Later (saved-card rail; every number is configurable) ───────
# Completed PAID rides on the SAME card needed to unlock the feature.
PAY_LATER_RIDES_TO_UNLOCK=5
# Starting credit limit in ZAR; +PAY_LATER_LIMIT_STEP_R every
# PAY_LATER_RIDES_PER_STEP further rides, capped at PAY_LATER_CAP_R.
PAY_LATER_CREDIT_LIMIT_R=100
PAY_LATER_LIMIT_STEP_R=50
PAY_LATER_RIDES_PER_STEP=10
PAY_LATER_CAP_R=1000
# Ride-to-repay: every N completed rides clears R PAY_LATER_REPAY_PER_RIDE_R
# off the balance (a PART of the debt, never the whole thing).
PAY_LATER_RIDES_TO_REPAY=4
PAY_LATER_REPAY_PER_RIDE_R=25
# Auto-debit retry schedule — days AFTER the due date (comma list).
# When the schedule is exhausted the account goes overdue → frozen.
PAY_LATER_RETRY_DAYS=1,3,7
# Optional threshold auto-debit (0 = off): consented riders whose WHOLE
# balance reaches this ZAR amount are charged regardless of due date.
PAY_LATER_AUTO_DEBIT_THRESHOLD_R=0
# Collection worker cadence (ms, floor 60000) + one catch-up run at boot.
PAY_LATER_WORKER_INTERVAL_MS=21600000
