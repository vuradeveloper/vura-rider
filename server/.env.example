# ── Server ──
PORT=3000
NODE_ENV=development

# ── PostgreSQL (AWS RDS) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vura

# ── Firebase Admin ──
# Download your service account JSON from Firebase Console → Project Settings → Service Accounts
# Encode it as base64: cat serviceAccountKey.json | base64
# Or set GOOGLE_APPLICATION_CREDENTIALS to the file path
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_service_account_json_here

# ── Maps ──
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
