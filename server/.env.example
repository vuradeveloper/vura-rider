NODE_ENV=development
PORT=3000

# PostgreSQL
# NOTE: The current DB is AWS RDS in us-east-1. The app + server run in South
# Africa, so every query crosses ~13,000 km (measured ~2s per new connection).
# To make the app feel fast, move the DB to a Johannesburg/Cape Town region:
#   - OCI-managed PostgreSQL in af-johannesburg-1, OR
#   - AWS RDS in af-south-1 (Cape Town), OR
#   - PostgreSQL on an Oracle VM in af-johannesburg-1
# Then just point DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD at it below and
# restart the service — no code changes needed.
DB_HOST=vura.cylqwqwmkmvc.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=vura2
DB_USER=vura_admin
DB_PASSWORD=vura2thinkdifferent

# Firebase Admin (from Firebase Console > Project Settings > Service Accounts)
FIREBASE_PROJECT_ID=vura-a272c
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@vura-a272c.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQDUjcMKvkz7eJaL..."

# CORS
ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug

# Pay Later / payments
# mock = simulated Paystack responses (default). sandbox = Paystack TEST key.
# live = Paystack LIVE key (real money).
PAYMENTS_MODE=mock
# Set to 1 to force mock collections to fail (tests the overdue/freeze path).
# PAYMENTS_MOCK_FAIL_COLLECT=1

# ── Paystack hosted payments ──
# Put the REAL values in server/.env (never in git). Placeholders shown here.
# Paystack gives you a secret key per business: TEST and LIVE.
#   PAYMENTS_MODE=sandbox → uses PAYSTACK_SECRET_TEST (test card 4084084084084081)
#   PAYMENTS_MODE=live    → uses PAYSTACK_SECRET_LIVE  (real money)
# Paystack SA checkout: https://paystack.com
PAYSTACK_SECRET_TEST=
PAYSTACK_SECRET_LIVE=
# Redirect-back URL on this server, e.g.
#   https://ridevura.com/api/payments/return
PAYSTACK_CALLBACK_URL=