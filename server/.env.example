# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
ENFORCE_HTTPS=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vura
DB_SSL=false
# For production, prefer a trusted CA. Use one of these if your provider requires it:
# DB_SSL_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DB_SSL_CA_BASE64=base64_encoded_ca_certificate

# Firebase Admin
# Download a service account JSON from Firebase Console > Project Settings > Service Accounts.
# Encode it as base64 and set it in your hosting provider, not in git.
FIREBASE_SERVICE_ACCOUNT_BASE64=base64_encoded_service_account_json

# Paystack
PAYSTACK_SECRET_KEY=sk_test_or_live_key_from_paystack
PAYSTACK_PUBLIC_KEY=pk_test_or_live_key_from_paystack

# Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
